# Copy to .env and fill in. .env is gitignored; never commit or print it.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=
# Deployment type of the Azure resource: global | datazone | regional  (used only for cost accounting)
AZURE_OPENAI_DEPLOYMENT_TYPE=
# Azure region of the resource, e.g. eastus2 (only needed when DEPLOYMENT_TYPE=regional)
AZURE_OPENAI_REGION=
# Hugging Face token (needed for gated models such as Llama-3.1-8B-Instruct)
HF_TOKEN=
